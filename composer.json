{
    "name": "argopecten/aegir-composer",
    "description": "Composer-based Aegir 3.x install",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "petergerner",
            "role": ""
        }
    ],
    "repositories": {
          "drupal/hosting_tasks_extra": {
              "type": "vcs",
              "url":  "https://github.com/argopecten/hosting_tasks_extra"
          },
          "drupal/hosting_civicrm": {
              "type": "vcs",
              "url":  "https://github.com/argopecten/hosting_civicrm"
          },
          "drupal/hosting_deploy": {
              "type": "vcs",
              "url":  "https://github.com/argopecten/hosting_deploy"
          },
          "drush/drush": {
              "type": "vcs",
              "url":  "https://github.com/argopecten/aegir-drush8"
          },
          "aegir/provision": {
              "type": "vcs",
              "url":  "https://github.com/argopecten/aegir-provision"
          },
          "drupal/hosting": {
              "type": "vcs",
              "url":  "https://github.com/argopecten/aegir-hosting"
          },
          "aegir/hostmaster": {
              "type": "vcs",
              "url":  "https://github.com/argopecten/aegir-hostmaster"
          },
          "drupal": {
                "type": "composer",
                "url": "https://packages.drupal.org/7"
          }
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "aegir/hostmaster": "dev-dev/latest",
        "composer/installers": "^1.9",
        "composer/semver": "^1.4",
        "cweagans/composer-patches": "^1.7",
        "sandykadam/preserve-paths": "^0.4",
        "drupal/composer_autoloader": "^1.0",
        "symfony/filesystem": "~2.7 || ^3",
        "webflo/drupal-finder": "^1.2.1"
    },
    "conflict": {
        "drupal/core": "8.*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "composer/installers": true,
            "sandykadam/preserve-paths": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ]
    },
    "scripts": {
        "pre-install-cmd": [
          "DrupalProject\\composer\\ScriptHandler::checkComposerVersion",
          "bash scripts/aegir/pre-install.sh"
        ],
        "pre-update-cmd": [
          "DrupalProject\\composer\\ScriptHandler::checkComposerVersion",
          "bash scripts/aegir/pre-update.sh"
        ],
        "post-install-cmd": [
          "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
          "bash scripts/aegir/post-install.sh"
        ],
        "post-update-cmd": [
          "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
          "bash scripts/aegir/post-update.sh"
        ],
        "post-root-package-install": [
          "bash scripts/aegir/post-root-package.sh"
        ],
        "post-create-project-cmd": [
          "DrupalProject\\composer\\ScriptHandler::removeInternalFiles",
          "bash scripts/aegir/post-create.sh"
        ]
    },
    "extra": {
        "installer-paths": {
            "drush/": ["drush/drush"],
            "drush/commands/{$name}/": ["type:drupal-drush"],
            "hostmaster/": ["type:drupal-core"],
            "hostmaster/profiles/{$name}/": ["type:drupal-profile"],
            "hostmaster/sites/all/libraries/{$name}/": ["type:drupal-library"],
            "hostmaster/sites/all/modules/contrib/{$name}/": ["type:drupal-module"],
            "hostmaster/sites/all/themes/contrib/{$name}/": ["type:drupal-theme"]
        },
        "preserve-paths": [
            "hostmaster/sites",
            "hostmaster/sites/all/modules/contrib",
            "hostmaster/sites/all/themes/contrib",
            "hostmaster/sites/all/libraries",
            "hostmaster/sites/default/settings.php",
            "hostmaster/sites/default/files"
        ],
        "patches-install-hooks": true,
        "patches": {
            "cweagans/composer-patches": {
                "Call the preserve paths hooks" : "https://github.com/jcnventura/composer-patches/compare/1.x...jcnventura:fix-preserve-paths.diff"
            },
            "drupal-composer/preserve-paths": {
                "Update PluginWrapper.php" : "https://github.com/lazysoundsystem/preserve-paths/commit/173dde446d161aa2beb5b1cafccfd14f2a8bbed4.patch"
            },
            "drupal/hosting_https": {
                "Nginx: Fix the try_files directive" : "https://git.drupalcode.org/project/hosting_https/-/merge_requests/1.diff"
            },
            "drupal/hosting_https": {
                "Nginx: ssl directive is deprecated" : "https://www.drupal.org/files/issues/2024-07-11/3313064-update-nginx-1.25-14.patch"
            }
        }
    }
}
